# Banco Ágil - Environment Variables Example
# Copy this file to .env and fill in the real values.
# NEVER commit real secrets, API keys, or tokens to version control.

# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Runtime provider selection is defined in backend settings/bootstrap.
# MockProvider is tests-only and must not be used in production/runtime env files.

# Canonical xAI key name (required for Grok provider)
XAI_API_KEY=

# OpenAI API Key (required for fallback/provider usage)
OPENAI_API_KEY=

# Provider endpoints and models
XAI_URL=https://api.x.ai/v1/chat/completions
OPENAI_URL=https://api.openai.com/v1/chat/completions
PRIMARY_MODEL=grok-4-1-fast
FALLBACK_MODEL=gpt-5.1

# ─── Exchange Rate Provider ────────────────────────────────────────────────────
# Optional external exchange-rate provider key (used by selected provider bootstrap)
EXCHANGE_API_KEY=
EXCHANGE_PROVIDER=searchapi
EXCHANGE_BASE_URL=https://www.searchapi.io/api/v1/search

# Optional provider-specific keys (keep empty placeholders)
SEARCHAPI_API_KEY=
TAVILY_API_KEY=
SERPAPI_API_KEY=

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=local
APP_VERSION=1.0.0
API_VERSION=v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Habilita endpoints admin de inspeção e reset de CSV (automático quando APP_ENV=local)
ADMIN_ENABLED=false

# ─── Data ─────────────────────────────────────────────────────────────────────
# Path to the directory containing runtime CSV files:
# clientes.csv, score_limite.csv, solicitacoes_aumento_limite.csv
DATA_DIR=app/data
